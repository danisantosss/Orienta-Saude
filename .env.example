# Copie para .env e preencha. O .env não vai para o Git.
# Os valores abaixo são só para rodar na sua máquina. Em produção cada um é um secret do Container App.
GEMINI_API_KEY=
DB_PASSWORD=root
# Chave de desenvolvimento. Em produção a aplicação não sobe sem um JWT_SECRET próprio.
JWT_SECRET=orienta-saude-dev-secret-key-min-256-bits-for-hs256-algorithm
# Chave AES-256 em Base64 que cifra os dados de saúde no banco (gere com: openssl rand -base64 32)
APP_CRIPTOGRAFIA_CHAVE=ZGV2LWxvY2FsLW9yaWVudGEtc2F1ZGUtMzItYnl0ZXM=
# Emails (separados por vírgula) das contas que recebem o papel ADMIN ao subir a aplicação
APP_ADMIN_EMAILS=
GRAFANA_PASSWORD=admin
